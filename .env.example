NODE_ENV=development
PORT=5000

# MongoDB Atlas (or any MongoDB) connection string, including the database name.
MONGODB_URI=mongodb://<user>:<password>@<host>/<database>?retryWrites=true&w=majority

# Signs/verifies short-lived access tokens.
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=30m

# HMAC key used to hash opaque refresh tokens before they're stored, and
# the TTL applied to each refresh token's expiresAt.
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=30d

# Used to build links in transactional emails (e.g. password reset).
CLIENT_URL=http://localhost:3000

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:3000

# Optional in development: if unset, emails are logged to the console
# instead of being sent.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Alight FMS <no-reply@alight-fms.local>

# Used once by `npm run seed:admin` to create the first Admin user.
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_COUNTRY_CODE=+1
SEED_ADMIN_PHONE=0000000000

# Used by `npm run seed:super-admin`. If a user with this email already
# exists, only its role is updated to Super Admin; the password/phone
# fields are only used if the account needs to be created fresh.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_COUNTRY_CODE=+1
SUPER_ADMIN_PHONE=0000000001
